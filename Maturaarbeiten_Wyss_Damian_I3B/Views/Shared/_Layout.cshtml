<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            :root {
                --wf-bg: #f4f5f7;
                --wf-surface: #ffffff;
                --wf-border: #2b2f36;
                --wf-accent: #e9ecef;
            }

            body {
                background-color: var(--wf-bg);
                color: #1f2328;
                font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
            }

            .wf-box {
                background: var(--wf-surface);
                border: 2px solid var(--wf-border);
                border-radius: 2px;
                box-shadow: 4px 4px 0px rgba(43, 47, 54, 0.12);
            }

            .wf-box-dashed {
                background: #fafafa;
                border: 2px dashed var(--wf-border);
                border-radius: 2px;
            }

            .wf-header {
                background: var(--wf-surface);
                border-bottom: 2px solid var(--wf-border);
            }

            .wf-badge {
                display: inline-block;
                border: 1.5px solid var(--wf-border);
                background: var(--wf-accent);
                padding: 2px 8px;
                font-size: 0.78rem;
                font-weight: 700;
            }

            .wf-btn {
                border: 2px solid var(--wf-border);
                border-radius: 2px;
                background: var(--wf-surface);
                color: #1f2328;
                font-weight: 600;
            }

                .wf-btn:hover:not(:disabled) {
                    background: var(--wf-accent);
                }

            .wf-btn-dark {
                background: #2b2f36;
                color: #ffffff;
            }

                .wf-btn-dark:hover:not(:disabled) {
                    background: #141619;
                    color: #ffffff;
                }

            .wf-input {
                border: 2px solid var(--wf-border);
                border-radius: 2px;
                background: #ffffff;
            }

            .wf-progress {
                height: 10px;
                border: 1.5px solid var(--wf-border);
                border-radius: 1px;
                background: #f1f3f5;
            }

            .wf-progress-bar {
                background: #495057;
                height: 100%;
            }

            .wf-nav-link.active {
                background: #2b2f36 !important;
                color: #ffffff !important;
            }
    </style>
</head>
<body>
    <header class="wf-header py-2 mb-4">
        <div class="container d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div>
                <div class="fw-bold small">Maturaarbeiten</div>
                <div class="text-muted" style="font-size: 0.75rem;" id="wf-session-info">Nicht angemeldet</div>
            </div>

            <nav id="wf-nav-student" class="d-none d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-sm wf-btn wf-nav-link active" data-view="katalog">Katalog</button>
                <button type="button" class="btn btn-sm wf-btn wf-nav-link" data-view="meine-buchungen">
                    Meine Buchungen <span id="wf-booking-count" class="badge text-bg-secondary ms-1">0/2</span>
                </button>
                <button type="button" class="btn btn-sm wf-btn" id="btn-logout-student">Logout</button>
            </nav>

            <nav id="wf-nav-admin" class="d-none d-flex flex-wrap align-items-center gap-2">
                <button type="button" class="btn btn-sm wf-btn wf-nav-link active" data-view="admin-dashboard">Dashboard</button>
                <button type="button" class="btn btn-sm wf-btn wf-nav-link" data-view="admin-csv">CSV-Import</button>
                <button type="button" class="btn btn-sm wf-btn wf-nav-link" data-view="admin-berichte">Berichte</button>
                <button type="button" class="btn btn-sm wf-btn wf-nav-link" data-view="admin-reset">System-Reset</button>
                <button type="button" class="btn btn-sm wf-btn" id="btn-logout-admin">Logout</button>
            </nav>
        </div>
    </header>

    <main class="container pb-5">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>